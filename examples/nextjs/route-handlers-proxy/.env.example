# Copy to .env.local before running: cp .env.example .env.local
# These are development placeholders. Generate real secrets for any deployment,
# for example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

# Shared secret for the HMAC-SHA256 signature on POST /api/webhooks/orders.
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Key used to sign the demo session cookie set by POST /api/session.
SESSION_SECRET=dev-session-secret-change-me-at-least-32-chars

# Comma-separated origins allowed to call GET /api/public/items from a browser.
ALLOWED_ORIGINS=http://localhost:5173,https://partner.example.com
