# Fake, non-secret demo values. Copy to .env.local to try the env-leak pair
# with `npm run build && npm run start`. The Playwright config and
# `npm run test:leak` set these themselves, so tests need no .env file.

# VULNERABLE: the NEXT_PUBLIC_ prefix inlines this value into browser JavaScript
# at build time. Never give a secret this prefix.
NEXT_PUBLIC_PAYMENTS_SECRET_KEY=sk_test_DEMO_LEAKED_0000

# FIXED: no prefix, read only from a `server-only` module.
PAYMENTS_SECRET_KEY=sk_test_DEMO_SERVER_ONLY_0000
