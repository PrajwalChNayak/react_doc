{
  "name": "@nextjs-examples/databases",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "db:migrate:prisma": "prisma migrate deploy",
    "db:migrate:drizzle": "drizzle-kit migrate",
    "db:migrate": "npm run db:migrate:prisma && npm run db:migrate:drizzle",
    "db:generate:prisma": "prisma migrate dev",
    "db:generate:drizzle": "drizzle-kit generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "prisma": "7.10.0",
    "typescript": "^5.9.0"
  }
}
